# Copy to .env and set your own values. .env is git-ignored and must never be committed.
# These are the defaults for `docker compose up -d` (PostgreSQL 16 + Redis 7).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=assessment
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assessment
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
